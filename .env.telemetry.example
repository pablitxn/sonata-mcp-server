# Telemetry Configuration for PandasAI Integration
# This file shows how to configure telemetry for full visibility of PandasAI operations

# Telemetry Provider Configuration
# Options: "langfuse", "noop" (no telemetry)
TELEMETRY_PROVIDER=langfuse

# Service identification
TELEMETRY_SERVICE_NAME=sonata-mcp-server
TELEMETRY_ENVIRONMENT=development

# Langfuse Configuration
# Get your keys from https://cloud.langfuse.com or your self-hosted instance
LANGFUSE_PUBLIC_KEY=your_public_key_here
LANGFUSE_SECRET_KEY=your_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional: Debug mode for verbose telemetry logging
TELEMETRY_DEBUG=false

# Optional: Sampling rate (0.0 to 1.0, default 1.0 = 100% of traces)
TELEMETRY_SAMPLE_RATE=1.0

# LLM Configuration (required for PandasAI)
LLM_PROVIDER=openai  # Options: openai, openrouter, ollama
LLM_CHOICE=gpt-4o-mini
LLM_API_KEY=your_openai_api_key_here

# Optional: For Ollama
# LLM_BASE_URL=http://localhost:11434

# Optional: For OpenRouter
# LLM_API_KEY=your_openrouter_api_key_here